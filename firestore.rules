rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny for all paths not explicitly allowed below
    match /{document=**} {
      allow read, write: if false;
    }

    // ==========================================
    // 1. Cloud Sync Backup Metadata (Private to user)
    // ==========================================
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ==========================================
    // 2. Helpers
    // ==========================================
    function isAuthenticated() {
      return request.auth != null;
    }

    // Legacy helper for v0.1.x trips
    function isTripMember(roiId) {
      let tripDoc = get(/databases/$(database)/documents/trips/$(roiId));
      return tripDoc != null && (
        request.auth.uid == tripDoc.data.authorId ||
        (('members' in tripDoc.data) && request.auth.uid in tripDoc.data.members)
      );
    }

    // ==========================================
    // 3. Legacy Shared Trips (v0.1.x, Frozen / Read-Only)
    // ==========================================
    match /trips/{tripId} {
      // Allow reading existing trip doc if caller is member/author
      allow read: if isAuthenticated() && (resource == null || isTripMember(tripId));
      // Writes are completely frozen on legacy trips collection after v0.1.x cutover
      allow write: if false;

      match /{allChildren=**} {
        allow read: if isAuthenticated() && isTripMember(tripId);
        allow write: if false;
      }
    }

    // ==========================================
    // 4. Shared Trips V2 (v0.2.x+ MVP Model)
    // ==========================================
    function isTripMemberV2(tripId) {
      let tripDoc = get(/databases/$(database)/documents/tripsV2/$(tripId));
      return tripDoc != null && (
        request.auth.uid == tripDoc.data.ownerId ||
        (('members' in tripDoc.data) && request.auth.uid in tripDoc.data.members)
      );
    }

    function isLwwValid() {
      // Last-Write-Wins based on updatedAt:
      // If document is newly created, valid.
      // If updated, request's updatedAt must be >= existing document's updatedAt.
      return resource == null || (
        !('updatedAt' in resource.data) ||
        !('updatedAt' in request.resource.data) ||
        request.resource.data.updatedAt >= resource.data.updatedAt
      );
    }

    function isTripV2Safe() {
      let data = request.resource.data;
      return (!('id' in data) || (data.id is string && data.id.size() <= 100))
        && (!('title' in data) || (data.title is string && data.title.size() <= 300))
        && (!('dayCount' in data) || (data.dayCount is number && data.dayCount >= 0));
    }

    function isDayBlockSafe() {
      let data = request.resource.data;
      return (!('id' in data) || (data.id is string && data.id.size() <= 100))
        && (!('sortKey' in data) || (data.sortKey is string && data.sortKey.size() <= 100));
    }

    function isStopSafe() {
      let data = request.resource.data;
      return (!('id' in data) || (data.id is string && data.id.size() <= 100))
        && (!('name' in data) || (data.name is string && data.name.size() <= 300))
        && (!('placeKey' in data) || (data.placeKey is string && data.placeKey.size() <= 200));
    }

    function isScheduleItemSafe() {
      let data = request.resource.data;
      return (!('id' in data) || (data.id is string && data.id.size() <= 100))
        && (!('sortKey' in data) || (data.sortKey is string && data.sortKey.size() <= 100))
        && (!('stayMinutes' in data) || (data.stayMinutes is number && data.stayMinutes >= 0))
        && (!('transitMinutes' in data) || (data.transitMinutes is number && data.transitMinutes >= 0));
    }

    match /tripsV2/{tripId} {
      allow read: if isAuthenticated() && (
        resource == null ||
        request.auth.uid == resource.data.ownerId ||
        (('members' in resource.data) && request.auth.uid in resource.data.members)
      );

      allow create: if isAuthenticated()
        && request.resource.data.ownerId == request.auth.uid
        && (request.auth.uid in request.resource.data.members)
        && isTripV2Safe();

      allow update: if isAuthenticated()
        && isTripMemberV2(tripId)
        && isLwwValid()
        && isTripV2Safe();

      // Deletes are soft-deleted via deletedAt tombstones
      allow delete: if false;

      match /days/{dayId} {
        allow read: if isAuthenticated() && isTripMemberV2(tripId);
        allow create, update: if isAuthenticated()
          && isTripMemberV2(tripId)
          && isLwwValid()
          && isDayBlockSafe();
        allow delete: if false;
      }

      match /stops/{stopId} {
        allow read: if isAuthenticated() && isTripMemberV2(tripId);
        allow create, update: if isAuthenticated()
          && isTripMemberV2(tripId)
          && isLwwValid()
          && isStopSafe();
        allow delete: if false;
      }

      match /schedule_items/{itemId} {
        allow read: if isAuthenticated() && isTripMemberV2(tripId);
        allow create, update: if isAuthenticated()
          && isTripMemberV2(tripId)
          && isLwwValid()
          && isScheduleItemSafe();
        allow delete: if false;
      }
    }
  }
}
