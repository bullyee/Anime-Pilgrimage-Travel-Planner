rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny for all paths not explicitly allowed below
    match /{document=**} {
      allow read, write: if false;
    }

    // ==========================================
    // 1. Cloud Sync Backup Metadata (Private to user)
    // ==========================================
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ==========================================
    // 2. Helpers
    // ==========================================
    function isAuthenticated() {
      return request.auth != null;
    }

    // Legacy helper for v0.1.x trips
    function isTripMember(roiId) {
      let tripDoc = get(/databases/$(database)/documents/trips/$(roiId));
      return tripDoc != null && (
        request.auth.uid == tripDoc.data.authorId ||
        (('members' in tripDoc.data) && request.auth.uid in tripDoc.data.members)
      );
    }

    function isStrictTimeChunkSafe() {
      let data = request.resource.data;
      let allowedKeys = [
        'id', 'poiId', 'date', 'startTime', 'endTime',
        'status', 'sortOrder', 'duration', 'transitDuration',
        'isFixedTime', 'authorId', 'updatedAt'
      ];
      let hasOnlyAllowedKeys = data.keys().hasOnly(allowedKeys);

      let isStatusSafe = !('status' in data) || data.status == null || (data.status is string && data.status.size() <= 30);
      let isIdSafe = !('id' in data) || (data.id is string && data.id.size() <= 100);
      let isDurationSafe = !('duration' in data) || (data.duration is number && data.duration >= 0);

      return hasOnlyAllowedKeys && isStatusSafe && isIdSafe && isDurationSafe;
    }

    function isStrictPoiSafe() {
      let data = request.resource.data;
      let allowedKeys = [
        'id', 'roiId', 'authorId', 'name', 'description', 'address',
        'lat', 'lng', 'businessHours', 'contactInfo',
        'remoteCoverImageUrl', 'sortOrder', 'updatedAt'
      ];
      return data.keys().hasOnly(allowedKeys)
        && (!('id' in data) || (data.id is string && data.id.size() <= 100))
        && (!('name' in data) || (data.name is string && data.name.size() <= 300));
    }

    // ==========================================
    // 3. Dual-Track: Shared Trips (v0.1.x Legacy)
    // ==========================================
    match /trips/{tripId} {
      // Creator must be the author and list themselves as a member.
      allow create: if isAuthenticated()
        && request.resource.data.authorId == request.auth.uid
        && (request.auth.uid in request.resource.data.members);

      allow read: if isAuthenticated() && (resource == null || isTripMember(tripId));
      allow delete: if isAuthenticated() && isTripMember(tripId);

      allow update: if isAuthenticated() && isTripMember(tripId) && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['syncLock']))
        ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && resource.data.members.hasAll(request.resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() - 1
          && !(request.auth.uid in request.resource.data.members)
        )
        ||
        (
          request.resource.data.cloudVersion == resource.data.cloudVersion + 1
          && request.resource.data.authorId == resource.data.authorId
          && request.resource.data.members == resource.data.members
          && (!('syncLock' in request.resource.data) || request.resource.data.syncLock == null)
          && (
            resource.data.syncLock == null
            || request.time > resource.data.syncLock.expiresAt
            || resource.data.syncLock.userId == request.auth.uid
          )
        )
      );

      match /timeChunks/{chunkId} {
        allow read, delete: if isAuthenticated() && isTripMember(tripId);
        allow create, update: if isAuthenticated() && isTripMember(tripId) && isStrictTimeChunkSafe();
      }

      match /pois/{poiId} {
        allow read, delete: if isAuthenticated() && isTripMember(tripId);
        allow create, update: if isAuthenticated() && isTripMember(tripId) && isStrictPoiSafe();
      }
    }

    // ==========================================
    // 4. Shared Trips V2 (v0.2.x+ MVP Model)
    // ==========================================
    function isTripMemberV2(tripId) {
      let tripDoc = get(/databases/$(database)/documents/tripsV2/$(tripId));
      return tripDoc != null && (
        request.auth.uid == tripDoc.data.ownerId ||
        (('members' in tripDoc.data) && request.auth.uid in tripDoc.data.members)
      );
    }

    function isLwwValid() {
      return resource == null || (
        !('updatedAt' in resource.data) ||
        !('updatedAt' in request.resource.data) ||
        request.resource.data.updatedAt >= resource.data.updatedAt
      );
    }

    function isTripV2Safe() {
      let data = request.resource.data;
      return (!('id' in data) || (data.id is string && data.id.size() <= 100))
        && (!('title' in data) || (data.title is string && data.title.size() <= 300))
        && (!('dayCount' in data) || (data.dayCount is number && data.dayCount >= 0));
    }

    function isDayBlockSafe() {
      let data = request.resource.data;
      return (!('id' in data) || (data.id is string && data.id.size() <= 100))
        && (!('sortKey' in data) || (data.sortKey is string && data.sortKey.size() <= 100));
    }

    function isStopSafe() {
      let data = request.resource.data;
      return (!('id' in data) || (data.id is string && data.id.size() <= 100))
        && (!('name' in data) || (data.name is string && data.name.size() <= 300))
        && (!('placeKey' in data) || (data.placeKey is string && data.placeKey.size() <= 200));
    }

    function isScheduleItemSafe() {
      let data = request.resource.data;
      return (!('id' in data) || (data.id is string && data.id.size() <= 100))
        && (!('sortKey' in data) || (data.sortKey is string && data.sortKey.size() <= 100))
        && (!('stayMinutes' in data) || (data.stayMinutes is number && data.stayMinutes >= 0))
        && (!('transitMinutes' in data) || (data.transitMinutes is number && data.transitMinutes >= 0));
    }

    match /tripsV2/{tripId} {
      allow read: if isAuthenticated() && (
        resource == null ||
        request.auth.uid == resource.data.ownerId ||
        (('members' in resource.data) && request.auth.uid in resource.data.members)
      );

      allow create: if isAuthenticated()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && isTripV2Safe();

      allow update: if isAuthenticated()
        && isTripMemberV2(tripId)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.members == resource.data.members
        && isLwwValid()
        && isTripV2Safe();

      // Deletes are soft-deleted via deletedAt tombstones
      allow delete: if false;

      match /days/{dayId} {
        allow read: if isAuthenticated() && isTripMemberV2(tripId);
        allow create, update: if isAuthenticated()
          && isTripMemberV2(tripId)
          && isLwwValid()
          && isDayBlockSafe();
        allow delete: if false;
      }

      match /stops/{stopId} {
        allow read: if isAuthenticated() && isTripMemberV2(tripId);
        allow create, update: if isAuthenticated()
          && isTripMemberV2(tripId)
          && isLwwValid()
          && isStopSafe();
        allow delete: if false;
      }

      match /schedule_items/{itemId} {
        allow read: if isAuthenticated() && isTripMemberV2(tripId);
        allow create, update: if isAuthenticated()
          && isTripMemberV2(tripId)
          && isLwwValid()
          && isScheduleItemSafe();
        allow delete: if false;
      }
    }
  }
}
