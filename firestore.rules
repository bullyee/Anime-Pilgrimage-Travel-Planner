rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny for all paths not explicitly allowed below
    match /{document=**} {
      allow read, write: if false;
    }

    // ==========================================
    // 1. Helpers
    // ==========================================
    function isAuthenticated() {
      return request.auth != null
        && (!('firebase' in request.auth.token)
            || !('sign_in_provider' in request.auth.token.firebase)
            || request.auth.token.firebase.sign_in_provider != 'anonymous');
    }

    // Legacy helper for v0.1.x trips
    function isTripMember(roiId) {
      let tripDoc = get(/databases/$(database)/documents/trips/$(roiId));
      return tripDoc != null && (
        request.auth.uid == tripDoc.data.authorId ||
        (('members' in tripDoc.data) && request.auth.uid in tripDoc.data.members)
      );
    }

    // ==========================================
    // 3. Dual-Track: Shared Trips (v0.1.x Legacy - Read Only)
    // ==========================================
    match /trips/{tripId} {
      allow read: if isAuthenticated() && isTripMember(tripId);
      allow create, update, delete: if false;

      match /timeChunks/{chunkId} {
        allow read: if isAuthenticated() && isTripMember(tripId);
        allow create, update, delete: if false;
      }

      match /pois/{poiId} {
        allow read: if isAuthenticated() && isTripMember(tripId);
        allow create, update, delete: if false;
      }
    }

    // ==========================================
    // 4. Shared Trips V2 & Group Sharing (Stage 3 + Stage 4 RBAC)
    // ==========================================
    function getTripDocV2(tripId) {
      let tripPath = /databases/$(database)/documents/tripsV2/$(tripId);
      return exists(tripPath) ? get(tripPath) : (existsAfter(tripPath) ? getAfter(tripPath) : null);
    }

    function getMemberDoc(tripId, uid) {
      let memberPath = /databases/$(database)/documents/tripsV2/$(tripId)/members/$(uid);
      return exists(memberPath) ? get(memberPath) : (existsAfter(memberPath) ? getAfter(memberPath) : null);
    }

    function isTripOwner(tripId) {
      let tripPath = /databases/$(database)/documents/tripsV2/$(tripId);
      return exists(tripPath)
        ? get(tripPath).data.ownerId == request.auth.uid
        : (existsAfter(tripPath) && getAfter(tripPath).data.ownerId == request.auth.uid);
    }

    function isTripMemberV2(tripId) {
      let tripDoc = getTripDocV2(tripId);
      let memberDoc = getMemberDoc(tripId, request.auth.uid);
      return tripDoc != null && (
        request.auth.uid == tripDoc.data.ownerId ||
        (
          ('sharing' in tripDoc.data) && tripDoc.data.sharing == 'group' && (
            (('members' in tripDoc.data) && request.auth.uid in tripDoc.data.members) ||
            (memberDoc != null && ('role' in memberDoc.data) && memberDoc.data.role in ['owner', 'editor', 'viewer'])
          )
        )
      );
    }

    // Role lookup: 'owner' | 'editor' | 'viewer' | ''
    function getTripRole(tripId) {
      let tripDoc = getTripDocV2(tripId);
      let memberDoc = getMemberDoc(tripId, request.auth.uid);
      return (tripDoc != null && request.auth.uid == tripDoc.data.ownerId)
        ? 'owner'
        : (tripDoc != null && ('sharing' in tripDoc.data) && tripDoc.data.sharing == 'group' && memberDoc != null && ('role' in memberDoc.data))
          ? memberDoc.data.role
          : '';
    }

    function isTripEditorOrOwner(tripId) {
      let role = getTripRole(tripId);
      return role == 'owner' || role == 'editor';
    }

    function isLwwValid() {
      return resource == null || (
        !('updatedAt' in resource.data) ||
        !('updatedAt' in request.resource.data) ||
        request.resource.data.updatedAt >= resource.data.updatedAt
      );
    }

    // id, when present, must equal the document path ID: the sync engine keys
    // local writes on it, so a mismatch would let one trip's editor overwrite
    // another trip on every member's device.
    function isTripV2Safe(docId) {
      let data = request.resource.data;
      return (!('id' in data) || data.id == docId)
        && (!('title' in data) || (data.title is string && data.title.size() <= 300))
        && (!('dayCount' in data) || (data.dayCount is number && data.dayCount >= 0));
    }

    function isDayBlockSafe(docId) {
      let data = request.resource.data;
      return (!('id' in data) || data.id == docId)
        && (!('sortKey' in data) || (data.sortKey is string && data.sortKey.size() <= 100));
    }

    function isStopSafe(docId) {
      let data = request.resource.data;
      return (!('id' in data) || data.id == docId)
        && (!('name' in data) || (data.name is string && data.name.size() <= 300))
        && (!('placeKey' in data) || (data.placeKey is string && data.placeKey.size() <= 200))
        && (!('area' in data) || data.area == null || (data.area is string && data.area.size() <= 100))
        && (!('note' in data) || data.note == null || (data.note is string && data.note.size() <= 2000));
    }

    function isScheduleItemSafe(docId) {
      let data = request.resource.data;
      return (!('id' in data) || data.id == docId)
        && (!('sortKey' in data) || (data.sortKey is string && data.sortKey.size() <= 100))
        && (!('stayMinutes' in data) || (data.stayMinutes is number && data.stayMinutes >= 0))
        && (!('transitMinutes' in data) || (data.transitMinutes is number && data.transitMinutes >= 0));
    }

    function isCreatorStillActive(tripId, creatorUid) {
      let tripPath = /databases/$(database)/documents/tripsV2/$(tripId);
      let memberPath = /databases/$(database)/documents/tripsV2/$(tripId)/members/$(creatorUid);
      let isOwner = exists(tripPath) && get(tripPath).data.ownerId == creatorUid;
      let isEditor = exists(memberPath) && ('role' in get(memberPath).data) && get(memberPath).data.role in ['owner', 'editor'];
      return isOwner || isEditor;
    }

    function isValidInviteJoin(tripId, memberUid) {
      let tripDoc = getTripDocV2(tripId);
      let inviteToken = request.resource.data.inviteToken;
      let inviteDoc = get(/databases/$(database)/documents/invites/$(inviteToken));
      return request.auth.uid == memberUid
        && tripDoc != null
        && tripDoc.data.sharing == 'group'
        && inviteDoc != null
        && inviteDoc.data.tripId == tripId
        && inviteDoc.data.role == request.resource.data.role
        && (!('isRevoked' in inviteDoc.data) || inviteDoc.data.isRevoked == false)
        && request.time < inviteDoc.data.expiresAt
        && isCreatorStillActive(tripId, inviteDoc.data.createdBy)
        && (!('emailAllowlist' in inviteDoc.data) || inviteDoc.data.emailAllowlist.size() == 0 || (request.auth.token.email != null && request.auth.token.email.lower() in inviteDoc.data.emailAllowlist));
    }

    function isSelfMemberArraySync(tripId) {
      let memberPath = /databases/$(database)/documents/tripsV2/$(tripId)/members/$(request.auth.uid);
      let onlyMembersChanged = request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']);
      let oldMembers = ('members' in resource.data) ? resource.data.members.toSet() : [].toSet();
      let newMembers = request.resource.data.members.toSet();
      return onlyMembersChanged && (
        (existsAfter(memberPath) && newMembers == oldMembers.union([request.auth.uid].toSet())) ||
        (!existsAfter(memberPath) && newMembers == oldMembers.difference([request.auth.uid].toSet()))
      );
    }

    match /tripsV2/{tripId} {
      // The app's trip listener: tripsV2 where members array-contains uid.
      allow list: if isAuthenticated() && request.auth.uid in resource.data.members;

      allow get: if isAuthenticated() && (
        resource == null ||
        request.auth.uid == resource.data.ownerId ||
        (resource.data.sharing == 'group' && (
          (('members' in resource.data) && request.auth.uid in resource.data.members) ||
          exists(/databases/$(database)/documents/tripsV2/$(tripId)/members/$(request.auth.uid))
        ))
      );

      allow create: if isAuthenticated()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && isTripV2Safe(tripId);

      // Only owner or editors can update trip metadata (viewers are read-only),
      // and only the owner can change ownerId, sharing, or remove members.
      // Joining/leaving members may sync their own UID in the members array in lockstep with /members/{uid}.
      allow update: if isAuthenticated() && (
        (isTripMemberV2(tripId)
          && isTripEditorOrOwner(tripId)
          && (!('ownerId' in request.resource.data) || request.resource.data.ownerId == resource.data.ownerId || isTripOwner(tripId))
          && (!('sharing' in request.resource.data) || request.resource.data.sharing == resource.data.sharing || isTripOwner(tripId))
          && (!('members' in request.resource.data) || !('members' in resource.data) || isTripOwner(tripId) || request.resource.data.members.toSet().hasAll(resource.data.members))
          && isLwwValid()
          && isTripV2Safe(tripId)) ||
        isSelfMemberArraySync(tripId)
      );

      // Direct hard deletes disallowed; soft-deletes via deletedAt tombstones
      allow delete: if false;

      // --- Members subcollection (Stage 4 RBAC) ---
      match /members/{memberUid} {
        allow read: if isAuthenticated() && isTripMemberV2(tripId);

        // Member creation:
        // (a) Owner adding self upon trip initialization
        // (b) User joining via valid invite token
        allow create: if isAuthenticated() && (
          (request.auth.uid == memberUid && isTripOwner(tripId)) ||
          isValidInviteJoin(tripId, memberUid)
        );

        // Member update:
        // (a) Self updating displayName / avatarUrl (role unchanged)
        // (b) Owner updating role / transferring ownership
        allow update: if isAuthenticated() && (
          (request.auth.uid == memberUid && request.resource.data.role == resource.data.role) ||
          (isTripOwner(tripId) && (
            request.resource.data.role in ['editor', 'viewer'] ||
            (request.resource.data.role == 'owner' &&
              existsAfter(/databases/$(database)/documents/tripsV2/$(tripId)) &&
              getAfter(/databases/$(database)/documents/tripsV2/$(tripId)).data.ownerId == memberUid)
          ))
        );

        // Member delete:
        // (a) Member leaving self (owner cannot leave without transfer)
        // (b) Owner kicking a non-owner member
        allow delete: if isAuthenticated() && (
          (request.auth.uid == memberUid && !isTripOwner(tripId)) ||
          (isTripOwner(tripId) && resource.data.role != 'owner')
        );
      }

      match /days/{dayId} {
        allow read: if isAuthenticated() && isTripMemberV2(tripId);
        allow create, update: if isAuthenticated()
          && isTripMemberV2(tripId)
          && isTripEditorOrOwner(tripId)
          && isLwwValid()
          && isDayBlockSafe(dayId);
        allow delete: if false;
      }

      match /stops/{stopId} {
        allow read: if isAuthenticated() && isTripMemberV2(tripId);
        allow create, update: if isAuthenticated()
          && isTripMemberV2(tripId)
          && isTripEditorOrOwner(tripId)
          && isLwwValid()
          && isStopSafe(stopId);
        allow delete: if false;
      }

      match /schedule_items/{itemId} {
        allow read: if isAuthenticated() && isTripMemberV2(tripId);
        allow create, update: if isAuthenticated()
          && isTripMemberV2(tripId)
          && isTripEditorOrOwner(tripId)
          && isLwwValid()
          && isScheduleItemSafe(itemId);
        allow delete: if false;
      }
    }

    // ==========================================
    // 5. Group Sharing Invites & Short Codes (Stage 4)
    // ==========================================
    function isInviteSafe() {
      let data = request.resource.data;
      return (!('tripTitle' in data) || (data.tripTitle is string && data.tripTitle.size() <= 300))
        && (!('inviterName' in data) || data.inviterName == null || (data.inviterName is string && data.inviterName.size() <= 200))
        && (!('inviterAvatarUrl' in data) || data.inviterAvatarUrl == null || (data.inviterAvatarUrl is string && data.inviterAvatarUrl.size() <= 1000))
        && (!('emailAllowlist' in data) || data.emailAllowlist == null || (data.emailAllowlist is list && data.emailAllowlist.size() <= 100));
    }

    match /invites/{token} {
      // Single-doc lookup by token is public so the web landing page and preview card can read it.
      // Listing is limited to the invites you made (the Members tab lists them), so nobody can
      // enumerate other people's tokens.
      allow get: if true;
      allow list: if isAuthenticated() && resource.data.createdBy == request.auth.uid;

      // Only Owner or Editor of the trip can create an editor/viewer invite,
      // with expiry strictly capped at 7 days from now.
      allow create: if isAuthenticated()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.role in ['editor', 'viewer']
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(7, 'd')
        && isTripEditorOrOwner(request.resource.data.tripId)
        && isInviteSafe();

      // Creator or Trip Owner can revoke or update expiration without mutating core invite fields,
      // with expiry strictly capped at 7 days from now.
      allow update: if isAuthenticated()
        && request.resource.data.tripId == resource.data.tripId
        && request.resource.data.role == resource.data.role
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.expiresAt <= request.time + duration.value(7, 'd')
        && (
          resource.data.createdBy == request.auth.uid ||
          isTripOwner(resource.data.tripId)
        )
        && isInviteSafe();

      allow delete: if isAuthenticated() && (
        resource.data.createdBy == request.auth.uid ||
        isTripOwner(resource.data.tripId)
      );
    }

    function canCreateInviteCode(token) {
      let invitePath = /databases/$(database)/documents/invites/$(token);
      let inviteDoc = exists(invitePath) ? get(invitePath) : (existsAfter(invitePath) ? getAfter(invitePath) : null);
      return inviteDoc != null && (
        inviteDoc.data.createdBy == request.auth.uid ||
        isTripOwner(inviteDoc.data.tripId)
      );
    }

    function canDeleteInviteCode(token) {
      let invitePath = /databases/$(database)/documents/invites/$(token);
      let inviteDoc = exists(invitePath) ? get(invitePath) : null;
      return (resource.data != null && ('createdBy' in resource.data) && resource.data.createdBy == request.auth.uid)
        || (inviteDoc != null && (inviteDoc.data.createdBy == request.auth.uid || isTripOwner(inviteDoc.data.tripId)));
    }

    match /invite_codes/{shortCode} {
      // Short code lookup is single-doc only
      allow get: if true;
      allow list: if false;

      // Only allow creating a short code if pointing to an invite doc created by auth.uid or owned trip
      allow create: if isAuthenticated()
        && request.resource.data.token is string
        && shortCode.size() == 6
        && (!('createdBy' in request.resource.data) || request.resource.data.createdBy == request.auth.uid)
        && canCreateInviteCode(request.resource.data.token);

      allow update: if false;

      allow delete: if isAuthenticated() && canDeleteInviteCode(resource.data.token);
    }

    // ==========================================
    // 6. Public Trip Templates (Phase 4)
    // ==========================================
    function canCreateTemplateCode(templateId) {
      let tPath = /databases/$(database)/documents/templates/$(templateId);
      return exists(tPath) || existsAfter(tPath);
    }

    match /templates/{templateId} {
      // Templates are public read-only snapshots (can be previewed without login)
      allow get, list: if true;

      // Anyone authenticated can publish an immutable template snapshot
      allow create: if isAuthenticated()
        && request.resource.data.id == templateId
        && request.resource.data.code is string
        && request.resource.data.code.size() == 6
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.dayCount is number
        && request.resource.data.dayCount >= 1
        && request.resource.data.dayCount <= 100
        && request.resource.data.stopCount is number
        && request.resource.data.stopCount >= 0;

      // Templates are immutable public snapshots
      allow update, delete: if false;
    }

    match /template_codes/{shortCode} {
      // Short code lookup is single-doc only
      allow get: if true;
      allow list: if false;

      // Creating a template code must link to a valid in-flight or existing template
      allow create: if isAuthenticated()
        && shortCode.size() == 6
        && request.resource.data.code == shortCode
        && request.resource.data.templateId is string
        && canCreateTemplateCode(request.resource.data.templateId);

      allow update, delete: if false;
    }
  }
}
