rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny for all paths not explicitly allowed below
    match /{document=**} {
      allow read, write: if false;
    }

    // ==========================================
    // 1. Cloud Sync Backup Metadata (Private to user)
    // ==========================================
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ==========================================
    // 2. Helpers
    // ==========================================
    function isAuthenticated() {
      return request.auth != null;
    }

    // Legacy helper for v0.1.x trips
    function isTripMember(roiId) {
      let tripDoc = get(/databases/$(database)/documents/trips/$(roiId));
      return tripDoc != null && (
        request.auth.uid == tripDoc.data.authorId ||
        (('members' in tripDoc.data) && request.auth.uid in tripDoc.data.members)
      );
    }

    function isStrictTimeChunkSafe() {
      let data = request.resource.data;
      let allowedKeys = [
        'id', 'poiId', 'date', 'startTime', 'endTime',
        'status', 'sortOrder', 'duration', 'transitDuration',
        'isFixedTime', 'authorId', 'updatedAt'
      ];
      let hasOnlyAllowedKeys = data.keys().hasOnly(allowedKeys);

      let isStatusSafe = !('status' in data) || data.status == null || (data.status is string && data.status.size() <= 30);
      let isIdSafe = !('id' in data) || (data.id is string && data.id.size() <= 100);
      let isDurationSafe = !('duration' in data) || (data.duration is number && data.duration >= 0);

      return hasOnlyAllowedKeys && isStatusSafe && isIdSafe && isDurationSafe;
    }

    function isStrictPoiSafe() {
      let data = request.resource.data;
      let allowedKeys = [
        'id', 'roiId', 'authorId', 'name', 'description', 'address',
        'lat', 'lng', 'businessHours', 'contactInfo',
        'remoteCoverImageUrl', 'sortOrder', 'updatedAt'
      ];
      return data.keys().hasOnly(allowedKeys)
        && (!('id' in data) || (data.id is string && data.id.size() <= 100))
        && (!('name' in data) || (data.name is string && data.name.size() <= 300));
    }

    // ==========================================
    // 3. Dual-Track: Shared Trips (v0.1.x Legacy)
    // ==========================================
    match /trips/{tripId} {
      // Creator must be the author and list themselves as a member.
      allow create: if isAuthenticated()
        && request.resource.data.authorId == request.auth.uid
        && (request.auth.uid in request.resource.data.members);

      allow read: if isAuthenticated() && (resource == null || isTripMember(tripId));
      allow delete: if isAuthenticated() && isTripMember(tripId);

      allow update: if isAuthenticated() && isTripMember(tripId) && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['syncLock']))
        ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && resource.data.members.hasAll(request.resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() - 1
          && !(request.auth.uid in request.resource.data.members)
        )
        ||
        (
          request.resource.data.cloudVersion == resource.data.cloudVersion + 1
          && request.resource.data.authorId == resource.data.authorId
          && request.resource.data.members == resource.data.members
          && (!('syncLock' in request.resource.data) || request.resource.data.syncLock == null)
          && (
            resource.data.syncLock == null
            || request.time > resource.data.syncLock.expiresAt
            || resource.data.syncLock.userId == request.auth.uid
          )
        )
      );

      match /timeChunks/{chunkId} {
        allow read, delete: if isAuthenticated() && isTripMember(tripId);
        allow create, update: if isAuthenticated() && isTripMember(tripId) && isStrictTimeChunkSafe();
      }

      match /pois/{poiId} {
        allow read, delete: if isAuthenticated() && isTripMember(tripId);
        allow create, update: if isAuthenticated() && isTripMember(tripId) && isStrictPoiSafe();
      }
    }

    // ==========================================
    // 4. Shared Trips V2 (v0.2.x+ MVP Model)
    // ==========================================
    function isTripMemberV2(tripId) {
      let tripDoc = get(/databases/$(database)/documents/tripsV2/$(tripId));
      let memberDoc = /databases/$(database)/documents/tripsV2/$(tripId)/members/$(request.auth.uid);
      return tripDoc != null && (
        request.auth.uid == tripDoc.data.ownerId ||
        (('members' in tripDoc.data) && request.auth.uid in tripDoc.data.members) ||
        exists(memberDoc)
      );
    }

    function getTripRole(tripId) {
      let tripDoc = get(/databases/$(database)/documents/tripsV2/$(tripId));
      let memberDoc = /databases/$(database)/documents/tripsV2/$(tripId)/members/$(request.auth.uid);
      return (tripDoc != null && request.auth.uid == tripDoc.data.ownerId)
        ? 'owner'
        : (exists(memberDoc) && 'role' in get(memberDoc).data ? get(memberDoc).data.role : 'editor');
    }

    function isTripOwner(tripId) {
      let tripDoc = get(/databases/$(database)/documents/tripsV2/$(tripId));
      let memberDoc = /databases/$(database)/documents/tripsV2/$(tripId)/members/$(request.auth.uid);
      return (tripDoc != null && request.auth.uid == tripDoc.data.ownerId) ||
        (exists(memberDoc) && get(memberDoc).data.role == 'owner');
    }

    function isTripEditorOrOwner(tripId) {
      let role = getTripRole(tripId);
      return role == 'owner' || role == 'editor';
    }

    function isLwwValid() {
      return resource == null || (
        !('updatedAt' in resource.data) ||
        !('updatedAt' in request.resource.data) ||
        request.resource.data.updatedAt >= resource.data.updatedAt
      );
    }

    function isTripV2Safe() {
      let data = request.resource.data;
      return (!('id' in data) || (data.id is string && data.id.size() <= 100))
        && (!('title' in data) || (data.title is string && data.title.size() <= 300))
        && (!('dayCount' in data) || (data.dayCount is number && data.dayCount >= 0));
    }

    function isDayBlockSafe() {
      let data = request.resource.data;
      return (!('id' in data) || (data.id is string && data.id.size() <= 100))
        && (!('sortKey' in data) || (data.sortKey is string && data.sortKey.size() <= 100));
    }

    function isStopSafe() {
      let data = request.resource.data;
      return (!('id' in data) || (data.id is string && data.id.size() <= 100))
        && (!('name' in data) || (data.name is string && data.name.size() <= 300))
        && (!('placeKey' in data) || (data.placeKey is string && data.placeKey.size() <= 200));
    }

    function isScheduleItemSafe() {
      let data = request.resource.data;
      return (!('id' in data) || (data.id is string && data.id.size() <= 100))
        && (!('sortKey' in data) || (data.sortKey is string && data.sortKey.size() <= 100))
        && (!('stayMinutes' in data) || (data.stayMinutes is number && data.stayMinutes >= 0))
        && (!('transitMinutes' in data) || (data.transitMinutes is number && data.transitMinutes >= 0));
    }

    function isValidInviteJoin(tripId, memberUid) {
      let inviteToken = request.resource.data.inviteToken;
      let inviteDoc = get(/databases/$(database)/documents/invites/$(inviteToken));
      return request.auth.uid == memberUid
        && inviteDoc != null
        && inviteDoc.data.tripId == tripId
        && inviteDoc.data.role == request.resource.data.role
        && (!('isRevoked' in inviteDoc.data) || inviteDoc.data.isRevoked == false)
        && request.time < inviteDoc.data.expiresAt
        && (!('emailAllowlist' in inviteDoc.data) || inviteDoc.data.emailAllowlist.size() == 0 || request.auth.token.email in inviteDoc.data.emailAllowlist);
    }

    match /tripsV2/{tripId} {
      allow read: if isAuthenticated() && (
        resource == null ||
        request.auth.uid == resource.data.ownerId ||
        (('members' in resource.data) && request.auth.uid in resource.data.members) ||
        exists(/databases/$(database)/documents/tripsV2/$(tripId)/members/$(request.auth.uid))
      );

      allow create: if isAuthenticated()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && isTripV2Safe();

      // Only owner or editors can update trip metadata (viewers are read-only)
      allow update: if isAuthenticated()
        && isTripMemberV2(tripId)
        && isTripEditorOrOwner(tripId)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.members == resource.data.members
        && isLwwValid()
        && isTripV2Safe();

      // Direct hard deletes disallowed; soft-deletes via deletedAt tombstones
      allow delete: if false;

      // --- Members subcollection (Stage 4 RBAC) ---
      match /members/{memberUid} {
        allow read: if isAuthenticated() && isTripMemberV2(tripId);

        // Member creation:
        // (a) Owner adding self upon trip initialization
        // (b) User joining via valid invite token
        allow create: if isAuthenticated() && (
          (request.auth.uid == memberUid && isTripOwner(tripId)) ||
          isValidInviteJoin(tripId, memberUid)
        );

        // Member update:
        // (a) Self updating displayName / avatarUrl (role unchanged)
        // (b) Owner updating role / transferring ownership
        allow update: if isAuthenticated() && (
          (request.auth.uid == memberUid && request.resource.data.role == resource.data.role) ||
          isTripOwner(tripId)
        );

        // Member delete:
        // (a) Member leaving self (owner cannot leave without transfer)
        // (b) Owner kicking a non-owner member
        allow delete: if isAuthenticated() && (
          (request.auth.uid == memberUid && resource.data.role != 'owner') ||
          (isTripOwner(tripId) && resource.data.role != 'owner')
        );
      }

      // --- Days subcollection ---
      match /days/{dayId} {
        allow read: if isAuthenticated() && isTripMemberV2(tripId);
        allow create, update: if isAuthenticated()
          && isTripMemberV2(tripId)
          && isTripEditorOrOwner(tripId)
          && isLwwValid()
          && isDayBlockSafe();
        allow delete: if false;
      }

      // --- Stops subcollection ---
      match /stops/{stopId} {
        allow read: if isAuthenticated() && isTripMemberV2(tripId);
        allow create, update: if isAuthenticated()
          && isTripMemberV2(tripId)
          && isTripEditorOrOwner(tripId)
          && isLwwValid()
          && isStopSafe();
        allow delete: if false;
      }

      // --- Schedule Items subcollection ---
      match /schedule_items/{itemId} {
        allow read: if isAuthenticated() && isTripMemberV2(tripId);
        allow create, update: if isAuthenticated()
          && isTripMemberV2(tripId)
          && isTripEditorOrOwner(tripId)
          && isLwwValid()
          && isScheduleItemSafe();
        allow delete: if false;
      }
    }

    // ==========================================
    // 5. Invites Collection (Stage 4 Group Sharing)
    // ==========================================
    match /invites/{token} {
      // Anyone with the token can read invite doc for public preview prior to joining
      allow read: if true;

      // Only owner or editor of the trip can create an invite
      allow create: if isAuthenticated()
        && isTripEditorOrOwner(request.resource.data.tripId)
        && request.resource.data.token == token
        && request.resource.data.createdBy == request.auth.uid;

      // Only trip owner or the inviter can update (e.g. revoke)
      allow update: if isAuthenticated() && (
        isTripOwner(resource.data.tripId) ||
        resource.data.createdBy == request.auth.uid
      );

      // Only trip owner can delete invite
      allow delete: if isAuthenticated() && isTripOwner(resource.data.tripId);
    }

    // Short code lookup for invites
    match /invite_codes/{code} {
      allow read: if true;
      allow create: if isAuthenticated()
        && exists(/databases/$(database)/documents/invites/$(request.resource.data.token));
      allow update, delete: if false;
    }
  }
}
